    (h01 : C 0 1 = 1) (h02 : C 0 2 = 2) (h03 : C 0 3 = 1) (h04 : C 0 4 = 0) (h05 : C 0 5 = 2) (h12 : C 1 2 = 2) (h13 : C 1 3 = 2) (h14 : C 1 4 = 1) (h15 : C 1 5 = 0) (h23 : C 2 3 = 0) (h24 : C 2 4 = 2) (h25 : C 2 5 = 2) (h34 : C 3 4 = 1) (h35 : C 3 5 = 2) (h45 : C 4 5 = 2) :
    False := by
  have h01' : C 1 0 = 1 := by rw [hC.symm]; exact h01
  have h02' : C 2 0 = 2 := by rw [hC.symm]; exact h02
  have h03' : C 3 0 = 1 := by rw [hC.symm]; exact h03
  have h04' : C 4 0 = 0 := by rw [hC.symm]; exact h04
  have h05' : C 5 0 = 2 := by rw [hC.symm]; exact h05
  have h12' : C 2 1 = 2 := by rw [hC.symm]; exact h12
  have h13' : C 3 1 = 2 := by rw [hC.symm]; exact h13
  have h14' : C 4 1 = 1 := by rw [hC.symm]; exact h14
  have h15' : C 5 1 = 0 := by rw [hC.symm]; exact h15
  have h23' : C 3 2 = 0 := by rw [hC.symm]; exact h23
  have h24' : C 4 2 = 2 := by rw [hC.symm]; exact h24
  have h25' : C 5 2 = 2 := by rw [hC.symm]; exact h25
  have h34' : C 4 3 = 1 := by rw [hC.symm]; exact h34
  have h35' : C 5 3 = 2 := by rw [hC.symm]; exact h35
  have h45' : C 5 4 = 2 := by rw [hC.symm]; exact h45
  have hGS : GS ![0, 1, 3, 5] C = !![6, -3, 1, 4; -3, 6, 4, -2; 1, 4, 6, 0; 4, -2, 0, 6] := by
    ext s t; fin_cases s <;> fin_cases t <;> simp [GS, G_apply, hC.diag, h01, h02, h03, h04, h05, h12, h13, h14, h15, h23, h24, h25, h34, h35, h45, h01', h02', h03', h04', h05', h12', h13', h14', h15', h23', h24', h25', h34', h35', h45']
  have hAdj : (!![16, 14, -12, -6; 14, 19, -15, -3; -12, -15, 15, 3; -6, -3, 3, 6] : Matrix (Fin 4) (Fin 4) ℤ) * GS ![0, 1, 3, 5] C = (18 : ℤ) • 1 := by
    rw [hGS]; decide
  have hAdjT : (!![16, 14, -12, -6; 14, 19, -15, -3; -12, -15, 15, 3; -6, -3, 3, 6] : Matrix (Fin 4) (Fin 4) ℤ)ᵀ = !![16, 14, -12, -6; 14, 19, -15, -3; -12, -15, 15, 3; -6, -3, 3, 6] := by decide
  have key : ∀ m : Fin 12, 6 ≤ m.val → C m 0 = 0 ∨ C m 0 = 1 := by
    intro m hm
    have hu : u m = 0 := u_of_ge6 m hm
    have hm0 : m ≠ 0 := ne_of_ge6 m hm 0 (by decide)
    have s0 : C 0 m = C m 0 := hC.symm 0 m
    have hm1 : m ≠ 1 := ne_of_ge6 m hm 1 (by decide)
    have s1 : C 1 m = C m 1 := hC.symm 1 m
    have hm2 : m ≠ 2 := ne_of_ge6 m hm 2 (by decide)
    have s2 : C 2 m = C m 2 := hC.symm 2 m
    have hm3 : m ≠ 3 := ne_of_ge6 m hm 3 (by decide)
    have s3 : C 3 m = C m 3 := hC.symm 3 m
    have hm4 : m ≠ 4 := ne_of_ge6 m hm 4 (by decide)
    have s4 : C 4 m = C m 4 := hC.symm 4 m
    have hm5 : m ≠ 5 := ne_of_ge6 m hm 5 (by decide)
    have s5 : C 5 m = C m 5 := hC.symm 5 m
    have f0 := hC.factor_apply ![0, 1, 3, 5] _ _ (by norm_num) hAdjT hAdj m 2
    have f1 := hC.factor_apply ![0, 1, 3, 5] _ _ (by norm_num) hAdjT hAdj m 4
    have fq := hC.factor_apply ![0, 1, 3, 5] _ _ (by norm_num) hAdjT hAdj m m
    have hus := hC.usum_expand m
    simp [Fin.sum_univ_four, G_apply, hC.diag, hu, hm0, hm1, hm2, hm3, hm4, hm5, s0, s1, s2, s3, s4, s5, h01, h02, h03, h04, h05, h12, h13, h14, h15, h23, h24, h25, h34, h35, h45, h01', h02', h03', h04', h05', h12', h13', h14', h15', h23', h24', h25', h34', h35', h45'] at f0 f1 fq
    have l0 := hC.nonneg m 0
    have g0 := hC.le4 m 0
    have l1 := hC.nonneg m 1
    have g1 := hC.le4 m 1
    have l2 := hC.nonneg m 2
    have g2 := hC.le4 m 2
    have l3 := hC.nonneg m 3
    have g3 := hC.le4 m 3
    have l4 := hC.nonneg m 4
    have g4 := hC.le4 m 4
    have l5 := hC.nonneg m 5
    have g5 := hC.le4 m 5
    generalize C m 0 = x0 at *
    generalize C m 1 = x1 at *
    generalize C m 2 = x2 at *
    generalize C m 3 = x3 at *
    generalize C m 4 = x4 at *
    generalize C m 5 = x5 at *
    have e0 : x0 = (0 : ℤ) + (-2) * x2 + (1) * x4 + (2) * x5 := by omega
    subst e0
    have e1 : x1 = (0 : ℤ) + (1) * x2 + (1) * x3 + (-1) * x5 := by omega
    subst e1
    interval_cases x2 <;> (try omega) <;> interval_cases x3 <;> (try omega) <;> interval_cases x4 <;> (try omega) <;> interval_cases x5 <;> omega
  have hrow := hC.row_expand 0
  have hsq := hC.sq_expand 0
  have k6 := key 6 (by decide)
  have t6 : C 0 6 = C 6 0 := hC.symm 0 6
  have k7 := key 7 (by decide)
  have t7 : C 0 7 = C 7 0 := hC.symm 0 7
  have k8 := key 8 (by decide)
  have t8 : C 0 8 = C 8 0 := hC.symm 0 8
  have k9 := key 9 (by decide)
  have t9 : C 0 9 = C 9 0 := hC.symm 0 9
  have k10 := key 10 (by decide)
  have t10 : C 0 10 = C 10 0 := hC.symm 0 10
  have k11 := key 11 (by decide)
  have t11 : C 0 11 = C 11 0 := hC.symm 0 11
  simp only [hC.diag, t6, t7, t8, t9, t10, t11, h01, h02, h03, h04, h05, h12, h13, h14, h15, h23, h24, h25, h34, h35, h45, h01', h02', h03', h04', h05', h12', h13', h14', h15', h23', h24', h25', h34', h35', h45', u0, u1, u2, u3, u4, u5] at hrow hsq
  generalize C 6 0 = c6 at *
  generalize C 7 0 = c7 at *
  generalize C 8 0 = c8 at *
  generalize C 9 0 = c9 at *
  generalize C 10 0 = c10 at *
  generalize C 11 0 = c11 at *
  rcases k6 with rfl | rfl <;> rcases k7 with rfl | rfl <;> rcases k8 with rfl | rfl <;> rcases k9 with rfl | rfl <;> rcases k10 with rfl | rfl <;> rcases k11 with rfl | rfl <;> omega

end Ordre7
