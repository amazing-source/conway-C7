theorem block_b28 (hC : IsOrbitMatrix C) (e01 : C 0 1 = 1) (e02 : C 0 2 = 2) (e03 : C 0 3 = 2) (e04 : C 0 4 = 1) (e05 : C 0 5 = 0) (e12 : C 1 2 = 2) (e13 : C 1 3 = 1) (e14 : C 1 4 = 0) (e15 : C 1 5 = 2) (e23 : C 2 3 = 0) (e24 : C 2 4 = 2) (e25 : C 2 5 = 2) (e34 : C 3 4 = 1) (e35 : C 3 5 = 2) (e45 : C 4 5 = 2) : False := by
  have e10 : C 1 0 = 1 := by rw [hC.symm]; exact e01
  have e20 : C 2 0 = 2 := by rw [hC.symm]; exact e02
  have e30 : C 3 0 = 2 := by rw [hC.symm]; exact e03
  have e40 : C 4 0 = 1 := by rw [hC.symm]; exact e04
  have e50 : C 5 0 = 0 := by rw [hC.symm]; exact e05
  have e21 : C 2 1 = 2 := by rw [hC.symm]; exact e12
  have e31 : C 3 1 = 1 := by rw [hC.symm]; exact e13
  have e41 : C 4 1 = 0 := by rw [hC.symm]; exact e14
  have e51 : C 5 1 = 2 := by rw [hC.symm]; exact e15
  have e32 : C 3 2 = 0 := by rw [hC.symm]; exact e23
  have e42 : C 4 2 = 2 := by rw [hC.symm]; exact e24
  have e52 : C 5 2 = 2 := by rw [hC.symm]; exact e25
  have e43 : C 4 3 = 1 := by rw [hC.symm]; exact e34
  have e53 : C 5 3 = 2 := by rw [hC.symm]; exact e35
  have e54 : C 5 4 = 2 := by rw [hC.symm]; exact e45
  have e00 : C 0 0 = 0 := hC.diag 0
  have e11 : C 1 1 = 0 := hC.diag 1
  have e22 : C 2 2 = 0 := hC.diag 2
  have e33 : C 3 3 = 0 := hC.diag 3
  have e44 : C 4 4 = 0 := hC.diag 4
  have e55 : C 5 5 = 0 := hC.diag 5
  have hGS : GS ![0, 1, 2, 3] C = !![6, -3, 0, 4; -3, 6, 0, 1; 0, 0, 6, -2; 4, 1, -2, 6] := by
    ext s t; fin_cases s <;> fin_cases t <;> simp [GS, G_apply, e01, e10, e02, e20, e03, e30, e04, e40, e05, e50, e12, e21, e13, e31, e14, e41, e15, e51, e23, e32, e24, e42, e25, e52, e34, e43, e35, e53, e45, e54, e00, e11, e22, e33, e44, e55]
  have hAdj : !![186, 120, -54, -162; 120, 96, -36, -108; -54, -36, 36, 54; -162, -108, 54, 162] * GS ![0, 1, 2, 3] C = (108 : ℤ) • 1 := by rw [hGS]; decide
  have hAdjT : (!![186, 120, -54, -162; 120, 96, -36, -108; -54, -36, 36, 54; -162, -108, 54, 162] : Matrix (Fin 4) (Fin 4) ℤ)ᵀ = !![186, 120, -54, -162; 120, 96, -36, -108; -54, -36, 36, 54; -162, -108, 54, 162] := by decide
  have hS : ∀ s, ((![0, 1, 2, 3] : Fin 4 → Fin 12) s).val < 6 := by decide
  have key : ∀ m : Fin 12, 6 ≤ m.val → C m 1 = 0 ∨ C m 1 = 1 := by
    intro m hm
    obtain ⟨n0, hn0⟩ := hC.nat5 m 0
    obtain ⟨n1, hn1⟩ := hC.nat5 m 1
    obtain ⟨n2, hn2⟩ := hC.nat5 m 2
    obtain ⟨n3, hn3⟩ := hC.nat5 m 3
    have hq := hC.fac_mm ![0, 1, 2, 3] _ 108 (by norm_num) hAdjT hAdj hS m hm
    simp only [Fin.sum_univ_four] at hq
    norm_num at hq
    have hl4 := hC.fac_mj ![0, 1, 2, 3] _ 108 (by norm_num) hAdjT hAdj hS m hm 4 (by decide)
    simp only [Fin.sum_univ_four] at hl4
    norm_num [G_apply, e01, e10, e02, e20, e03, e30, e04, e40, e05, e50, e12, e21, e13, e31, e14, e41, e15, e51, e23, e32, e24, e42, e25, e52, e34, e43, e35, e53, e45, e54, e00, e11, e22, e33, e44, e55] at hl4
    have hl5 := hC.fac_mj ![0, 1, 2, 3] _ 108 (by norm_num) hAdjT hAdj hS m hm 5 (by decide)
    simp only [Fin.sum_univ_four] at hl5
    norm_num [G_apply, e01, e10, e02, e20, e03, e30, e04, e40, e05, e50, e12, e21, e13, e31, e14, e41, e15, e51, e23, e32, e24, e42, e25, e52, e34, e43, e35, e53, e45, e54, e00, e11, e22, e33, e44, e55] at hl5
    have hcu := hC.usum_expand m
    have hp := pred_b28_all ![n0, n1, n2, n3]
    have z0 : zc ![n0, n1, n2, n3] 0 = C m 0 := by rw [hn0]; rfl
    have z1 : zc ![n0, n1, n2, n3] 1 = C m 1 := by rw [hn1]; rfl
    have z2 : zc ![n0, n1, n2, n3] 2 = C m 2 := by rw [hn2]; rfl
    have z3 : zc ![n0, n1, n2, n3] 3 = C m 3 := by rw [hn3]; rfl
    unfold pred_b28 at hp
    rw [z0, z1, z2, z3] at hp
    have hL4 : 108 * (3 * C m 4 - 4) = l4_b28 (C m 0) (C m 1) (C m 2) (C m 3) := by unfold l4_b28; linear_combination hl4
    have hw4 : wv (l4_b28 (C m 0) (C m 1) (C m 2) (C m 3)) 108 = C m 4 := ediv_of_mul_eq (by norm_num) hL4
    have hL5 : 108 * (3 * C m 5 - 4) = l5_b28 (C m 0) (C m 1) (C m 2) (C m 3) := by unfold l5_b28; linear_combination hl5
    have hw5 : wv (l5_b28 (C m 0) (C m 1) (C m 2) (C m 3)) 108 = C m 5 := ediv_of_mul_eq (by norm_num) hL5
    have hQ : 108 * 8 = qf_b28 (C m 0) (C m 1) (C m 2) (C m 3) := by
      unfold qf_b28; linear_combination hq
    have hp2 := hp hQ (by rw [hw4]; exact hL4) (by rw [hw4]; exact hC.nonneg m 4) (by rw [hw4]; exact hC.le4 m 4) (by rw [hw5]; exact hL5) (by rw [hw5]; exact hC.nonneg m 5) (by rw [hw5]; exact hC.le4 m 5)
    simp only [hw4, hw5] at hp2
    exact hp2 (by linarith)
  have hrow := hC.row_expand 1
  have hsq := hC.sq_expand 1
  simp only [e01, e10, e02, e20, e03, e30, e04, e40, e05, e50, e12, e21, e13, e31, e14, e41, e15, e51, e23, e32, e24, e42, e25, e52, e34, e43, e35, e53, e45, e54, e00, e11, e22, e33, e44, e55, u0, u1, u2, u3, u4, u5] at hrow hsq
  have k6 : C 1 6 = 0 ∨ C 1 6 = 1 := by rw [hC.symm]; exact key 6 (by decide)
  have s6 : C 1 6 * C 1 6 = 1 * C 1 6 - 0 := by
    rcases k6 with h | h <;> rw [h] <;> norm_num
  have k7 : C 1 7 = 0 ∨ C 1 7 = 1 := by rw [hC.symm]; exact key 7 (by decide)
  have s7 : C 1 7 * C 1 7 = 1 * C 1 7 - 0 := by
    rcases k7 with h | h <;> rw [h] <;> norm_num
  have k8 : C 1 8 = 0 ∨ C 1 8 = 1 := by rw [hC.symm]; exact key 8 (by decide)
  have s8 : C 1 8 * C 1 8 = 1 * C 1 8 - 0 := by
    rcases k8 with h | h <;> rw [h] <;> norm_num
  have k9 : C 1 9 = 0 ∨ C 1 9 = 1 := by rw [hC.symm]; exact key 9 (by decide)
  have s9 : C 1 9 * C 1 9 = 1 * C 1 9 - 0 := by
    rcases k9 with h | h <;> rw [h] <;> norm_num
  have k10 : C 1 10 = 0 ∨ C 1 10 = 1 := by rw [hC.symm]; exact key 10 (by decide)
  have s10 : C 1 10 * C 1 10 = 1 * C 1 10 - 0 := by
    rcases k10 with h | h <;> rw [h] <;> norm_num
  have k11 : C 1 11 = 0 ∨ C 1 11 = 1 := by rw [hC.symm]; exact key 11 (by decide)
  have s11 : C 1 11 * C 1 11 = 1 * C 1 11 - 0 := by
    rcases k11 with h | h <;> rw [h] <;> norm_num
  rw [s6, s7, s8, s9, s10, s11] at hsq
  omega

end Conway7
